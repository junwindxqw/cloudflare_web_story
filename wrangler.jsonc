{
  // Cloudflare Workers 配置：前端静态资源 + 后端 API 在同一个 Worker 内
  // 一键部署时 R2 / D1 资源由 Cloudflare 自动创建并回填 database_id
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-web-story",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 禁用 HTML 路径规范化（否则 /login.html 会被 307 到 /login，与页面门禁互相成环）
    "html_handling": "none",
    // 页面与 API 走 Worker（做登录校验）；静态资源直接由 CDN 边缘分发
    "run_worker_first": ["/api/*", "/", "/login", "/read/*"]
  },
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "web-story-books"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-story-db",
      // 手动部署时运行 `npm run setup` 会自动创建并回填此 ID
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    // 发件人（需 Resend 已验证的域名），例如 "书阁 <noreply@your-domain.com>"
    "MAIL_FROM": "书阁 <noreply@your-domain.com>",
    // 本地调试：为 "true" 时验证码会同时返回在接口响应中。部署到线上必须保持 false！
    "DEV_SHOW_CODE": "false",
    // 单次上传大小上限（MB），Cloudflare 免费版请求体上限为 100MB
    "MAX_UPLOAD_MB": "100"
    // 邮件服务用 Resend（免费额度 100 封/天）：
    //   1. 在 https://resend.com 注册并验证发送域名
    //   2. 执行 `wrangler secret put RESEND_API_KEY` 配置 API Key
    // 未配置时验证码只会打印到 Worker 日志（仅适合本地开发）
  },
  "observability": {
    "enabled": true
  }
}
